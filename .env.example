# Variables the application reads. Values are the code defaults, except
# secrets, which are placeholders. Commented names are still read; leave them
# unset unless you mean to override. Do not put real secret values here.
#
# Platform variables are omitted on purpose. Azure and GitHub inject PORT,
# WEBSITE_*, and GITHUB_*. Gunicorn binds to PORT (default 8000). `python
# app.py` uses PORT with default 5000. WEBSITE_AUTH_ENABLED is set by App
# Service Authentication, not by this file.

# LLM provider: openai, azure_openai, anthropic, huggingface,
# openai_compatible, deepseek, qwen (DashScope), or zhipu.
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Empty unless EMBEDDING_PROVIDER=azure_openai. The code default is empty.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Deployment names used only by the side-by-side advising benchmark.
AZURE_BENCHMARK_LEFT_DEPLOYMENT=gpt-4o-mini
AZURE_BENCHMARK_RIGHT_DEPLOYMENT=gpt-5.6-luna
# The student GPT-4o mini deployment currently needs conservative pacing.
BENCHMARK_REQUEST_DELAY_SECONDS=60

# hashing is the offline default. Also accepted: auto, local, azure_openai, openai.
EMBEDDING_PROVIDER=hashing

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-2

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-hf

# Generic OpenAI-compatible endpoint (optional)
OPENAI_COMPATIBLE_API_KEY=your_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible; the official endpoint does not use /v1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud Model Studio / DashScope (Qwen).
# DASHSCOPE_* is preferred. QWEN_API_KEY and QWEN_BASE_URL are aliases.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# QWEN_API_KEY=
# QWEN_BASE_URL=
# DASHSCOPE_MODEL=qwen-plus

# Zhipu / Z.ai (GLM). ZAI_API_KEY is the documented name; ZHIPU_API_KEY is an alias.
ZAI_API_KEY=your_zai_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
# ZHIPU_API_KEY=
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZAI_MODEL=glm-5.2

# Leave VECTOR_STORE_PATH unset. Local default is ./data/chroma. On Azure App
# Service the default is /home/data/chroma. Do not set /tmp/chroma or
# /home/site/wwwroot/data/chroma (wwwroot is replaced on every zip deploy).
# VECTOR_STORE_PATH=./data/chroma
VECTOR_COLLECTION_NAME=advising_documents
# Unset uses the advising document directories chosen in code.
# DOCS_PATH=
DEBUG=false

# Read at startup. The chat client does not attach a LangSmith callback.
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=

# Comma-separated browser origins. This is the code default. Append any extra
# origin explicitly; a GitHub Pages host is not included unless you add it.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://ischooladvisingchatbot-dx4ynl.azurewebsites.net

# Web security and operational limits
# Long random value in production. Unset uses an ephemeral development key.
SESSION_SECRET_KEY=replace_with_a_long_random_secret
# Required to rebuild or read document indexes through the admin endpoints.
DOCS_LOAD_TOKEN=replace_with_a_separate_admin_token
# Shared secret for /evaluation. Unset disables that login. Localhost can open
# the workspace without it. Not set on the current Azure app.
EVAL_ACCESS_TOKEN=replace_with_a_long_review_workspace_secret
# Comma-separated reviewer emails. Unset means this allowlist is empty.
# EVAL_ALLOWED_REVIEWERS=
# Unset: the web app uses evals/results/latest.json beside the app. The
# benchmark uses that same relative path. Leave unset unless you mean to override.
# EVAL_RESULTS_PATH=evals/results/latest.json
# Leave unset on Azure to use /home/data/evaluation/reviews.sqlite3. Setting
# that same path is equivalent. Local default is evals/reviews.sqlite3.
# EVAL_DB_PATH=./evals/reviews.sqlite3
# Code default is false. Production sets true because HTTPS Only is enabled.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# Unset means production only on App Service. production or prod enables it.
# APP_ENV=
# Legacy alias of APP_ENV.
# FLASK_ENV=
# Unset means 1 trusted proxy hop on App Service and 0 elsewhere. Clamped to 0-5.
# TRUSTED_PROXY_COUNT=
MAX_REQUEST_BYTES=65536
CHAT_MESSAGE_MAX_LENGTH=4000
RAG_TOP_K=5
RAG_RESPONSE_MAX_CHARS=12000
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
MAX_CHAT_SESSIONS=10000
MAX_HISTORY_MESSAGES=50
CHAT_SESSION_TTL_SECONDS=3600
DOCS_LOAD_RATE_LIMIT=2
DOCS_LOAD_RATE_WINDOW_SECONDS=600

# Optional process and chat-client overrides. Unset keeps the defaults in
# gunicorn.conf.py and src/llm_providers.py.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=180
# GUNICORN_GRACEFUL_TIMEOUT=210
# LLM_TEMPERATURE=0.2
# LLM_REQUEST_TIMEOUT=45
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=1024

# scripts/verify_deployed_index.py (CI). The web app does not read this.
# APP_URL=

# Legacy local-only MLIS fixture (off by default; never indexed as ISDA evidence)
ALLOW_SAMPLE_DOCS=false

# Browser voice controls (no speech-provider credentials)
VOICE_ENABLED=true
VOICE_MODE=browser
VOICE_STT_ENABLED=true
VOICE_TTS_ENABLED=true
VOICE_LANGUAGES=en-US,zh-CN
VOICE_DEFAULT_LANGUAGE=en-US
# Keep false unless reviewed for your deployment's consent requirements.
VOICE_AUTO_SEND=false
VOICE_MAX_UTTERANCE_CHARS=1000
