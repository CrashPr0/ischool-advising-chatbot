# LLM Provider Configuration
# Choose a provider: openai, azure_openai, anthropic, huggingface,
# openai_compatible, deepseek, qwen (DashScope), or zhipu

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# Optional deployment names used only by the side-by-side advising benchmark.
AZURE_BENCHMARK_LEFT_DEPLOYMENT=gpt-4o-mini
AZURE_BENCHMARK_RIGHT_DEPLOYMENT=gpt-5.6-luna
# The student GPT-4o mini deployment currently needs conservative pacing.
BENCHMARK_REQUEST_DELAY_SECONDS=60

# Hashing is offline and quota-free; choose auto only when hosted semantic
# embeddings are configured and worth the additional cost.
EMBEDDING_PROVIDER=hashing

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-2

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-hf

# Generic OpenAI-compatible endpoint (optional)
# Use this for a self-hosted gateway or any compatible service not listed below.
OPENAI_COMPATIBLE_API_KEY=your_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example.com/v1
OPENAI_COMPATIBLE_MODEL=your-model-name

# DeepSeek (OpenAI-compatible; the official endpoint does not use /v1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud Model Studio / DashScope (Qwen)
# For production, use the workspace-specific base URL for your region when
# available. DASHSCOPE_API_KEY and DASHSCOPE_BASE_URL are the preferred names;
# QWEN_API_KEY and QWEN_BASE_URL are accepted aliases.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Zhipu / Z.ai (GLM)
# ZAI_API_KEY is the provider's documented environment-variable name;
# ZHIPU_API_KEY is accepted as an alias.
ZAI_API_KEY=your_zai_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2

# Application Configuration
DEFAULT_LLM_PROVIDER=openai
VECTOR_COLLECTION_NAME=advising_documents
# Leave VECTOR_STORE_PATH and EVAL_DB_PATH unset on Azure App Service.
# App Service then uses the persistent share:
#   VECTOR_STORE_PATH=/home/data/chroma
#   EVAL_DB_PATH=/home/data/evaluation/reviews.sqlite3
# Do not set VECTOR_STORE_PATH=/tmp/chroma. That directory is wiped on restart.
# Local development, with both variables unset, uses ./data/chroma and
# evals/reviews.sqlite3 beside the app. Uncomment the local paths only when
# you want to pin them:
# VECTOR_STORE_PATH=./data/chroma
# EVAL_DB_PATH=./evals/reviews.sqlite3
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://ischooladvisingchatbot-dx4ynl.azurewebsites.net,https://<your-github-username>.github.io

# Web security and operational limits
# Use a long random value in deployed environments; the development fallback is ephemeral.
SESSION_SECRET_KEY=replace_with_a_long_random_secret
# Required to rebuild/read document indexes through protected admin endpoints.
DOCS_LOAD_TOKEN=replace_with_a_separate_admin_token
# Shared secret for the internal human-evaluation workspace. Localhost can be
# used without it; deployed environments should always set a strong value.
EVAL_ACCESS_TOKEN=replace_with_a_long_review_workspace_secret
EVAL_RESULTS_PATH=./evals/results/latest.json
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
MAX_REQUEST_BYTES=65536
CHAT_MESSAGE_MAX_LENGTH=4000
RAG_RESPONSE_MAX_CHARS=12000
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
MAX_CHAT_SESSIONS=10000
MAX_HISTORY_MESSAGES=50
CHAT_SESSION_TTL_SECONDS=3600
DOCS_LOAD_RATE_LIMIT=2
DOCS_LOAD_RATE_WINDOW_SECONDS=600

# Process and model-client settings are being chosen in a separate change.
# Confirm the final names before setting them in App Service. Expect values for
# the Gunicorn worker class, thread count, request timeout, and graceful
# timeout, plus the chat LLM request timeout and max_tokens. Do not invent
# placeholders here. Keep the platform health check on /healthz.

# Legacy local-only MLIS fixture (off by default and never indexed as ISDA evidence)
ALLOW_SAMPLE_DOCS=false

# Browser voice controls (no speech-provider credentials required)
# The browser uses Web Speech API recognition/synthesis when supported.
VOICE_ENABLED=true
VOICE_MODE=browser
VOICE_STT_ENABLED=true
VOICE_TTS_ENABLED=true
VOICE_LANGUAGES=en-US,zh-CN
VOICE_DEFAULT_LANGUAGE=en-US
# Keep false unless reviewed for your deployment's consent/UX requirements.
VOICE_AUTO_SEND=false
VOICE_MAX_UTTERANCE_CHARS=1000
